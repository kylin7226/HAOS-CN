arm64: dts: rockchip: pwm-fan cooling for Radxa Rock 5B

Enable pwm1 and add a pwm-fan cooling device (pwm1 ch0 / GPIO0_C0, 50000ns
period) bound to the bigcore0/bigcore2/little-core thermal zones via active
trips + cooling-maps, so the kernel drives the fan with no userspace daemon.
cooling-levels and trip temperatures follow Radxa's reference fan curve and
should be tuned on real hardware.

--- a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
@@ -62,3 +62,65 @@
 	pinctrl-names = "default";
 	pinctrl-0 = <&vcc5v0_host_en>;
 };
+
+&pwm1 {
+	status = "okay";
+};
+
+fan: pwm-fan {
+	compatible = "pwm-fan";
+	pwms = <&pwm1 0 50000 0>;
+	cooling-levels = <0 100 160 210 255>;
+	#cooling-cells = <2>;
+};
+
+/*
+ * Active fan cooling on the three CPU thermal zones. cooling-levels above give
+ * five states (off / ~39% / ~63% / ~82% / 100%); the trips step the fan through
+ * states 1..4 as a cluster warms. Temperatures follow Radxa's reference fan
+ * curve and should be tuned on real hardware.
+ */
+&bigcore0_thermal {
+	trips {
+		bc0_fan_on: fan-on { temperature = <45000>; hysteresis = <2000>; type = "active"; };
+		bc0_fan_low: fan-low { temperature = <55000>; hysteresis = <2000>; type = "active"; };
+		bc0_fan_med: fan-med { temperature = <65000>; hysteresis = <2000>; type = "active"; };
+		bc0_fan_high: fan-high { temperature = <75000>; hysteresis = <2000>; type = "active"; };
+	};
+	cooling-maps {
+		map-fan-on { trip = <&bc0_fan_on>; cooling-device = <&fan 1 1>; };
+		map-fan-low { trip = <&bc0_fan_low>; cooling-device = <&fan 2 2>; };
+		map-fan-med { trip = <&bc0_fan_med>; cooling-device = <&fan 3 3>; };
+		map-fan-high { trip = <&bc0_fan_high>; cooling-device = <&fan 4 4>; };
+	};
+};
+
+&bigcore2_thermal {
+	trips {
+		bc2_fan_on: fan-on { temperature = <45000>; hysteresis = <2000>; type = "active"; };
+		bc2_fan_low: fan-low { temperature = <55000>; hysteresis = <2000>; type = "active"; };
+		bc2_fan_med: fan-med { temperature = <65000>; hysteresis = <2000>; type = "active"; };
+		bc2_fan_high: fan-high { temperature = <75000>; hysteresis = <2000>; type = "active"; };
+	};
+	cooling-maps {
+		map-fan-on { trip = <&bc2_fan_on>; cooling-device = <&fan 1 1>; };
+		map-fan-low { trip = <&bc2_fan_low>; cooling-device = <&fan 2 2>; };
+		map-fan-med { trip = <&bc2_fan_med>; cooling-device = <&fan 3 3>; };
+		map-fan-high { trip = <&bc2_fan_high>; cooling-device = <&fan 4 4>; };
+	};
+};
+
+&little_core_thermal {
+	trips {
+		lc_fan_on: fan-on { temperature = <45000>; hysteresis = <2000>; type = "active"; };
+		lc_fan_low: fan-low { temperature = <55000>; hysteresis = <2000>; type = "active"; };
+		lc_fan_med: fan-med { temperature = <65000>; hysteresis = <2000>; type = "active"; };
+		lc_fan_high: fan-high { temperature = <75000>; hysteresis = <2000>; type = "active"; };
+	};
+	cooling-maps {
+		map-fan-on { trip = <&lc_fan_on>; cooling-device = <&fan 1 1>; };
+		map-fan-low { trip = <&lc_fan_low>; cooling-device = <&fan 2 2>; };
+		map-fan-med { trip = <&lc_fan_med>; cooling-device = <&fan 3 3>; };
+		map-fan-high { trip = <&lc_fan_high>; cooling-device = <&fan 4 4>; };
+	};
+};
