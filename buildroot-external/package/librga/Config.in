config BR2_PACKAGE_LIBRGA
	bool "librga"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_USES_GLIBC
	help
	  Rockchip Raster Graphic Acceleration (RGA) userspace library
	  (prebuilt aarch64). Drives RGA2/RGA3 2D acceleration
	  (blit/scale/convert/csc) via /dev/rga. Used by ffmpeg-rockchip.

	  https://github.com/airockchip/librga
