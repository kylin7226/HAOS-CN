config BR2_PACKAGE_LIBRKNNRT
	bool "librknnrt"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_USES_GLIBC
	help
	  Rockchip RKNN runtime (librknnrt.so) for the RK3588 NPU.
	  Prebuilt aarch64 library plus C API headers from airockchip
	  rknn-toolkit2. Requires the rknpu kernel driver (/dev/rknpu).

	  https://github.com/airockchip/rknn-toolkit2
