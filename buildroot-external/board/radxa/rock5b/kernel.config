# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

CONFIG_THERMAL_GOV_BANG_BANG=y

CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# RK3588 eMMC/SD via Synopsys DWC SDHCI
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# Rock 5B M.2 NVMe (PCIe3 x4) and the DWC PCIe host controller
CONFIG_PCI=y
CONFIG_PCIE_DW_ROCKCHIP=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# Rock 5B 2.5GbE Realtek RTL8125BG
CONFIG_R8169=y

# RK3588 clock/reset/power-domain drivers
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_REGULATOR_FAN53555=y

# CPU cooling / DVFS
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ROCKCHIP_THERMAL=y

# --- RK3588 media/AI stack core subsystems (MPP/RGA/RKNPU/Mali deps) ---
# dma-buf / CMA / dma-heap: zero-copy buffer sharing for codec + RGA + NPU
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=256
CONFIG_DMA_HEAP=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# IOMMU (RGA3 / VPU981 AV1 / RKNPU per-device IOVA)
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_API=y
CONFIG_IOMMU_DMA=y
CONFIG_ROCKCHIP_IOMMU=y

# DRM / display (Rockchip VOP; Mali-G610 GPU is mainline Panthor, see below; DRM_PRIME for ffmpeg-rockchip)
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_GEM_DMA_HELPER=y

# V4L2 / media framework (Hantro rkvdec2 + vendor codec paths)
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_V4L2_MEM2MEM_DEV=y

# devfreq for the RKNPU 200-800MHz DVFS (rknpu driver)
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y

# Loadable module support (RKNPU is still an out-of-tree module)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- RK3588 vendor MPP codec + RGA, built in-tree ---
# Provided by the ysp forward-port patches in patches/linux/ (rk3588-rkvenc2
# 01 drivers + 02 device tree) applied to pristine mainline v6.18. ysp's
# combined kernel builds these =y (built-in); the DKMS out-of-tree variant
# clashes with that, so we use the in-tree form.
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_PROC_FS=y
CONFIG_ROCKCHIP_MPP_RKVENC2=y
CONFIG_ROCKCHIP_MPP_RKVDEC2=y
CONFIG_ROCKCHIP_MULTI_RGA=y
CONFIG_ROCKCHIP_RGA_ASYNC=y
CONFIG_ROCKCHIP_RGA_DEBUG_FS=y

# --- GPU: mainline Panthor for Mali-G610 (open driver, no libmali blob) ---
# The RK3588 Mali-G610 is a Valhall CSF GPU ("arm,mali-valhall-csf"), bound by
# the mainline panthor driver; panfrost only covers Midgard/Bifrost (non-CSF).
# The board DT already enables &gpu (rk3588-rock-5b-5bp-5t.dtsi). Provides
# /dev/dri/renderD* for GPU consumers; containers bring their own Mesa. Host
# Mesa3D is intentionally omitted (its gallium drivers now pull host-LLVM +
# Rust, disproportionate for a headless appliance).
CONFIG_DRM_PANTHOR=y

# --- Fan control (kernel pwm-fan + thermal) ---
# Rock 5B fan header = pwm1 ch0 (pin pwm1_m0 / GPIO0_C0), period 50000ns.
# CONFIG_SENSORS_PWM_FAN registers a cooling device; the board DT patch
# patches/linux/*-rock5b-pwm-fan.patch adds the pwm-fan node and binds it to
# the CPU thermal zones with active trips + cooling-maps, so the kernel drives
# the fan with no userspace daemon. pwm1 + its pinctrl already exist in
# rk3588-base.dtsi (the board patch only sets status="okay").
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_SENSORS_PWM_FAN=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
