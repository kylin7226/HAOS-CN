CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_CMD_LED=y

# Rock 5B boots from eMMC/NVMe/SD; make sure the boot script can reach all of them
CONFIG_NVME=y
CONFIG_PCI=y
CONFIG_DM_PCI=y
CONFIG_PCIE_DW_ROCKCHIP=y
CONFIG_CMD_NVME=y
CONFIG_CMD_PCI=y
CONFIG_SCSI=y
CONFIG_DM_SCSI=y
CONFIG_CMD_SCSI=y

# 2.5GbE Realtek RTL8125 (r8169 in Linux); keep U-Boot net/PHY support on
CONFIG_PHY_REALTEK=y
CONFIG_PHY_GIGADEVICE=y
